{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embeddedsearchengine-lugarerrado",
  "main": "./worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "embeddedsearchengine.lugarerrado.com/*",
      "zone_name": "lugarerrado.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "SEARCH_BACKEND": "https://lugarerrado-searxng-vladicho.onrender.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
